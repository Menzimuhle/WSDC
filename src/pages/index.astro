---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="WSDC Judge Training">
  <section class="hero">
    <p class="eyebrow">World Schools Debating Championships</p>
    <h1>WSDC Judge training</h1>
    <p class="lead">Short modules based on the WSDC Debate &amp; Adjudication Manual, practice quizzes that show you the answers we expect, and the final judge test used for tournament placement.</p>
    <div class="row">
      <a class="btn" href={base + 'modules/'}>Start training</a>
      <a class="btn btn-ghost" id="hero-continue" hidden>Continue where you left off</a>
    </div>
  </section>

  <section class="grid" style="margin-top:40px">
    <div class="card"><h3 style="margin-top:0">1. Train</h3><p class="muted" style="margin:0">Work through the modules at your own pace. Each covers one part of judging: speaker roles, new material, clash, scoring, oral adjudications.</p></div>
    <div class="card"><h3 style="margin-top:0">2. Practise</h3><p class="muted" style="margin:0">Every module ends with a practice quiz. You see the expected answer and the reasoning straight away, and your best score is saved.</p></div>
    <div class="card"><h3 style="margin-top:0">3. Final test</h3><p class="muted" style="margin:0">When the CA team opens it, take the final test: multiple choice, judging a recorded debate, and written answers marked by the CAs.</p></div>
  </section>

  <h2>Modules</h2>
  <ol class="module-list" id="module-list"><li class="muted">Loading…</li></ol>
</Base>
<style>
  .hero { padding: 32px 0 8px; }
  .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; font-weight: 600; color: var(--accent); margin: 0; }
  .lead { font-size: 1.15rem; color: var(--ink-2); max-width: 640px; }
  .module-list li { margin-bottom: 8px; }
</style>
<script>
  import { path, esc } from '../lib/supabase.js';
  import { fetchModules } from '../lib/modules.js';
  import { loadProgress, nextModule } from '../lib/progress.js';
  (async () => {
    const listEl = document.getElementById('module-list')!;
    const modules = await fetchModules().catch(() => []);
    listEl.innerHTML = modules.map((m: any) => `<li><a href="${path('module/?m=' + m.slug)}">${esc(m.title)}</a> <span class="muted small">· ${esc(m.summary)}</span></li>`).join('')
      || '<li class="muted">Modules will appear here once published.</li>';
    const progress = await loadProgress();
    if (!Object.keys(progress).length) return;
    const next = nextModule(modules, progress);
    if (!next) return;
    const a = document.getElementById('hero-continue') as HTMLAnchorElement;
    a.href = path('module/?m=' + next.slug);
    a.textContent = `Continue: ${next.title} →`;
    a.hidden = false;
  })();
</script>
