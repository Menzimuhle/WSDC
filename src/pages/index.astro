---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="WSDC Judge Training">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">World Schools Debating Championships · Sofia 2027</p>
      <h1>Learn to judge WSDC with confidence</h1>
      <p class="lead">Free and open to everyone, no sign-up email needed. Short modules based on the WSDC Debate &amp; Adjudication Manual, practice quizzes that show you the answers we expect, and the final judge test used for tournament placement.</p>
      <div class="row">
        <a class="btn" href={base + 'modules/'}>Start training</a>
        <a class="btn btn-ghost" id="hero-continue" hidden>Continue where you left off</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="hero-badge"><img class="hero-logo" src={base + 'logo.png'} alt="Sofia WSDC 2027" width="221" height="284" /></div>
    </div>
  </section>

  <section class="grid" style="margin-top:40px">
    <div class="card"><h3 style="margin-top:0">1. Train</h3><p class="muted" style="margin:0">Work through the modules at your own pace. Each covers one part of judging: speaker roles, new material, clash, scoring, oral adjudications.</p></div>
    <div class="card"><h3 style="margin-top:0">2. Practise</h3><p class="muted" style="margin:0">Every module ends with a practice quiz. You see the expected answer and the reasoning straight away, and your best score is saved.</p></div>
    <div class="card"><h3 style="margin-top:0">3. Final test</h3><p class="muted" style="margin:0">When the CA team opens it, take the final test: multiple choice, judging a recorded debate, and written answers marked by the CAs.</p></div>
  </section>

  <h2>Modules</h2>
  <ol class="module-list" id="module-list"><li class="muted">Loading…</li></ol>
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1fr 300px; overflow: hidden; background: var(--brand-black); color: #fff;
    border-radius: 20px; margin-top: 8px; }
  .hero-copy { padding: 40px 36px; }
  .hero h1 { color: #fff; margin: .2em 0 .4em; }
  .eyebrow { text-transform: uppercase; letter-spacing: .1em; font-size: .75rem; font-weight: 600; margin: 0; font-family: var(--display);
    background: var(--brand-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { font-size: 1.08rem; color: rgba(255,255,255,.82); }
  .hero .btn-ghost { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.6); }
  /* Right panel: brand gradient with the logo on a black badge */
  .hero-art { background: var(--brand-grad); display: grid; place-items: center; min-height: 260px; padding: 28px; }
  .hero-badge { background: var(--brand-black); border-radius: 18px; padding: 18px 22px; box-shadow: 0 10px 30px rgba(0, 0, 0, .25); }
  .hero-logo { display: block; width: 130px; height: auto; }
  .module-list li { margin-bottom: 8px; }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .hero-art { order: -1; min-height: 0; padding: 22px; }
    .hero-badge { padding: 12px 16px; border-radius: 14px; }
    .hero-logo { width: 84px; }
    .hero-copy { padding: 26px 20px 30px; }
  }
</style>
<script>
  import { path, esc } from '../lib/supabase.js';
  import { fetchModules } from '../lib/modules.js';
  import { loadProgress, nextModule } from '../lib/progress.js';
  (async () => {
    const listEl = document.getElementById('module-list')!;
    const modules = await fetchModules().catch(() => []);
    listEl.innerHTML = modules.map((m: any) => `<li><a href="${path('module/?m=' + m.slug)}">${esc(m.title)}</a> <span class="muted small">· ${esc(m.summary)}</span></li>`).join('')
      || '<li class="muted">Modules will appear here once published.</li>';
    const progress = await loadProgress();
    if (!Object.keys(progress).length) return;
    const next = nextModule(modules, progress);
    if (!next) return;
    const a = document.getElementById('hero-continue') as HTMLAnchorElement;
    a.href = path('module/?m=' + next.slug);
    a.textContent = `Continue: ${next.title} →`;
    a.hidden = false;
  })();
</script>
