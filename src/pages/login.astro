---
import Base from '../layouts/Base.astro';
---
<Base title="Sign in">
  <div style="max-width:440px;margin:24px auto">
    <h1>Sign in</h1>
    <p class="muted">You don't need to sign in to do the training. Use this page to pick up your training on another device (after confirming your email), or if you're on the CA team. For the final test, go to the <a href="../final/">Final test</a> page. If you trained without confirming your email, sign in with the same email you gave, and your progress is brought across automatically.</p>
    <form id="login" class="card">
      <div class="field">
        <label for="email">Email address</label>
        <input id="email" type="email" required autocomplete="email" />
      </div>
      <button class="btn" type="submit" style="width:100%">Send sign-in link</button>
      <div id="msg" class="notice" hidden></div>
    </form>
  </div>
</Base>
<script>
  import { supabase, path } from '../lib/supabase.js';
  const form = document.getElementById('login') as HTMLFormElement;
  const msg = document.getElementById('msg')!;
  const show = (t: string, kind = '') => { msg.hidden = false; msg.className = 'notice ' + kind; msg.textContent = t; };

  if (!supabase) {
    show('Sign-in is switched off until Supabase is connected.', 'notice-warn');
    (form.querySelector('button') as HTMLButtonElement).disabled = true;
  } else {
    supabase.auth.getSession().then(({ data }) => { if (data.session && !data.session.user.is_anonymous) location.href = path('account/'); });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim().toLowerCase();
      const btn = form.querySelector('button') as HTMLButtonElement;
      btn.disabled = true;
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: location.origin + path('account/') },
      });
      btn.disabled = false;
      if (error) show(error.message, 'notice-bad');
      else show(`Check ${email} for a sign-in link. It can take a minute, and may land in spam.`, 'notice-good');
    });
  }
</script>
