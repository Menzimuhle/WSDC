---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PracticeQuiz from '../../components/PracticeQuiz.astro';
import TraineeGate from '../../components/TraineeGate.astro';
import { youtubeEmbed } from '../../lib/supabase.js';

export async function getStaticPaths() {
  const all = (await getCollection('modules', (m) => !m.data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1] } }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const embed = youtubeEmbed(entry.data.video);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p class="small"><a href={base + 'modules/'}>← All modules</a></p>
  <p class="muted small" style="margin:0">Module {entry.data.order}{entry.data.minutes ? ` · about ${entry.data.minutes} min` : ''}</p>
  <h1>{entry.data.title}</h1>
  <p class="muted">{entry.data.summary}</p>
  <TraineeGate />
  <div class="gated">
  {embed && <div class="video"><iframe src={embed} title={entry.data.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe></div>}
  <article class="prose"><Content /></article>
  <PracticeQuiz slug={entry.id} quiz={entry.data.quiz} />
  <div class="card row" style="justify-content:space-between" id="complete-card" data-slug={entry.id}>
    <span id="complete-text">Finished this module? Mark it complete to record your progress.</span>
    <button class="btn" id="complete-btn">Mark complete</button>
  </div>
  <nav class="row" style="justify-content:space-between;margin-top:24px" aria-label="Module navigation">
    {prev ? <a href={base + 'modules/' + prev.id + '/'}>← {prev.data.title}</a> : <span></span>}
    {next && <a href={base + 'modules/' + next.id + '/'}>{next.data.title} →</a>}
  </nav>
  </div>
</Base>

<script>
  import { toast } from '../../lib/supabase.js';
  import { loadProgress, saveProgress } from '../../lib/progress.js';
  const card = document.getElementById('complete-card')!;
  const btn = document.getElementById('complete-btn') as HTMLButtonElement;
  const text = document.getElementById('complete-text')!;
  const slug = card.dataset.slug!;

  function setDone(when: string) {
    text.textContent = `Completed on ${new Date(when).toLocaleDateString()}.`;
    btn.textContent = 'Completed ✓';
    btn.disabled = true;
  }

  document.addEventListener('trainee-ready', async () => {
    const progress = await loadProgress();
    const mine = progress[slug];
    if (mine?.completed_at) setDone(mine.completed_at);
    // Record the visit so "Continue where you left off" can bring them back here.
    await saveProgress(slug, {});
  });

  btn.onclick = async () => {
    const now = new Date().toISOString();
    await saveProgress(slug, { completed_at: now });
    setDone(now);
    toast('Module marked complete');
  };
</script>
