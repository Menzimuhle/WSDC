---
import Base from '../../layouts/Base.astro';
---
<Base title="Modules">
  <h1>Training modules</h1>
  <p class="muted">Work through the modules in order. Each one ends with a practice quiz that shows you the answers we expect and why.</p>
  <div class="card" id="overall" hidden>
    <div class="row" style="justify-content:space-between"><strong id="overall-title">Your progress</strong><span id="overall-text" class="muted small"></span></div>
    <div class="progress" style="margin-top:8px"><span id="overall-bar"></span></div>
    <a class="btn" id="continue" style="margin-top:14px" hidden>Continue where you left off</a>
  </div>
  <div id="list" style="margin-top:20px"><p class="muted">Loading modules…</p></div>
</Base>
<style is:global>
  .module-link { display: block; text-decoration: none; color: inherit; transition: border-color .15s; }
  .module-link:hover { border-color: var(--accent); }
</style>
<script>
  import { supabase, path, esc } from '../../lib/supabase.js';
  import { fetchModules } from '../../lib/modules.js';
  import { currentTrainee, loadProgress, nextModule } from '../../lib/progress.js';

  (async () => {
    const list = document.getElementById('list')!;
    if (!supabase) { list.innerHTML = '<div class="notice notice-warn">Modules load from Supabase, which isn\'t connected yet.</div>'; return; }
    let modules: any[];
    try { modules = await fetchModules(); } catch (e: any) { list.innerHTML = `<div class="notice notice-bad">${esc(e.message)}</div>`; return; }
    if (!modules.length) { list.innerHTML = '<p class="muted">No modules have been published yet.</p>'; return; }

    const [progress, t] = await Promise.all([loadProgress(), currentTrainee()]);
    let done = 0;
    list.innerHTML = modules.map((m, i) => {
      const r: any = (progress as any)[m.slug];
      let badge = '';
      if (r?.completed_at) { done++; badge = `<span class="badge badge-good">Completed${r.practice_total ? ` · quiz ${r.practice_score}/${r.practice_total}` : ''}</span>`; }
      else if (r) badge = `<span class="badge badge-warn">In progress${r.practice_total ? ` · quiz ${r.practice_score}/${r.practice_total}` : ''}</span>`;
      const n = (m.quiz || []).length;
      return `<a class="card module-link" href="${path('module/?m=' + m.slug)}">
        <div class="row" style="justify-content:space-between">
          <span class="muted small">Module ${i + 1}${m.minutes ? ` · ${m.minutes} min` : ''}${n ? ` · ${n}-question practice quiz` : ''}</span>${badge}
        </div>
        <h2 style="margin:.3em 0">${esc(m.title)}</h2>
        <p class="muted" style="margin:0">${esc(m.summary)}</p></a>`;
    }).join('');

    if (!Object.keys(progress).length && !t?.profile?.full_name) return;
    document.getElementById('overall')!.hidden = false;
    if (t?.profile?.full_name) document.getElementById('overall-title')!.textContent = `Welcome back, ${t.profile.full_name.split(' ')[0]}`;
    document.getElementById('overall-text')!.textContent = `${done} of ${modules.length} modules completed`;
    (document.getElementById('overall-bar') as HTMLElement).style.width = `${(done / modules.length) * 100}%`;
    const next = nextModule(modules, progress);
    const btn = document.getElementById('continue') as HTMLAnchorElement;
    if (next && Object.keys(progress).length) {
      btn.href = path('module/?m=' + next.slug);
      btn.textContent = `Continue: ${next.title} →`;
      btn.hidden = false;
    } else if (!next) {
      btn.outerHTML = '<p class="notice notice-good" style="margin:14px 0 0">You have completed every module. Well done!</p>';
    }
  })();
</script>
