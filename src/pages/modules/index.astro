---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const modules = (await getCollection('modules', (m) => !m.data.draft)).sort((a, b) => a.data.order - b.data.order);
const list = modules.map((m) => ({ slug: m.id, title: m.data.title }));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Modules">
  <script type="application/json" id="modules-data" set:html={JSON.stringify(list)}></script>
  <h1>Training modules</h1>
  <p class="muted">Work through the modules in order. Each one ends with a practice quiz that shows you the answers we expect and why.</p>
  <div class="card" id="overall" hidden>
    <div class="row" style="justify-content:space-between"><strong id="overall-title">Your progress</strong><span id="overall-text" class="muted small"></span></div>
    <div class="progress" style="margin-top:8px"><span id="overall-bar"></span></div>
    <a class="btn" id="continue" style="margin-top:14px" hidden>Continue where you left off</a>
  </div>
  <div style="margin-top:20px">
    {modules.map((m) => (
      <a class="card module-link" href={base + 'modules/' + m.id + '/'} data-slug={m.id}>
        <div class="row" style="justify-content:space-between">
          <span class="muted small">Module {m.data.order}{m.data.minutes ? ` · ${m.data.minutes} min` : ''}{m.data.quiz.length ? ` · ${m.data.quiz.length}-question practice quiz` : ''}</span>
          <span class="badge status" hidden></span>
        </div>
        <h2 style="margin:.3em 0">{m.data.title}</h2>
        <p class="muted" style="margin:0">{m.data.summary}</p>
      </a>
    ))}
  </div>
</Base>
<style>
  .module-link { display: block; text-decoration: none; color: inherit; transition: border-color .15s; }
  .module-link:hover { border-color: var(--accent); }
</style>
<script>
  import { path } from '../../lib/supabase.js';
  import { currentTrainee, loadProgress, nextModule } from '../../lib/progress.js';
  (async () => {
    const modules = JSON.parse(document.getElementById('modules-data')!.textContent!);
    const progress: Record<string, any> = await loadProgress();
    const t = await currentTrainee();
    if (!Object.keys(progress).length && !t?.profile?.full_name) return;
    const links = document.querySelectorAll<HTMLElement>('.module-link');
    let done = 0;
    links.forEach((el) => {
      const r = progress[el.dataset.slug!];
      const badge = el.querySelector('.status') as HTMLElement;
      if (r?.completed_at) { done++; badge.textContent = 'Completed'; badge.className = 'badge badge-good status'; badge.hidden = false; }
      else if (r) { badge.textContent = 'In progress'; badge.className = 'badge badge-warn status'; badge.hidden = false; }
      if (r?.practice_total) badge.textContent += ` · quiz ${r.practice_score}/${r.practice_total}`;
    });
    document.getElementById('overall')!.hidden = false;
    if (t?.profile?.full_name) document.getElementById('overall-title')!.textContent = `Welcome back, ${t.profile.full_name.split(' ')[0]}`;
    document.getElementById('overall-text')!.textContent = `${done} of ${links.length} modules completed`;
    (document.getElementById('overall-bar') as HTMLElement).style.width = `${(done / Math.max(links.length, 1)) * 100}%`;
    const next = nextModule(modules, progress);
    const btn = document.getElementById('continue') as HTMLAnchorElement;
    if (next && Object.keys(progress).length) {
      btn.href = path('modules/' + next.slug + '/');
      btn.textContent = `Continue: ${next.title} →`;
      btn.hidden = false;
    } else if (!next) {
      btn.outerHTML = '<p class="notice notice-good" style="margin:14px 0 0">You have completed every module. Well done!</p>';
    }
  })();
</script>
