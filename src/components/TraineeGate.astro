---
// Asks first-time visitors for their details before showing training content.
// Wrap gated content in an element with class="gated".
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div id="trainee-gate" hidden>
  <form class="card" id="trainee-form" style="max-width:560px">
    <h2 style="margin-top:0">Before you start</h2>
    <p class="muted">Tell us who you are so your progress is saved and the CA team can see which judges have completed the training. No password or email link needed.</p>
    <div class="field"><label for="t-name">Full name</label><input id="t-name" type="text" required maxlength="120" autocomplete="name" /></div>
    <div class="field"><label for="t-email">Email <span class="hint">(the one you registered with for the tournament)</span></label><input id="t-email" type="email" required autocomplete="email" /></div>
    <div class="field"><label for="t-nation">Nation / affiliation</label><input id="t-nation" type="text" maxlength="80" placeholder="e.g. Kenya" /></div>
    <label class="row small" style="font-weight:400;align-items:flex-start;flex-wrap:nowrap"><input type="checkbox" id="t-consent" required style="margin-top:4px" />
      <span>I agree that my name, email, nation and training progress are stored and shared with the WSDC CA team.</span></label>
    <div class="row" style="margin-top:14px">
      <button class="btn" type="submit">Start training</button>
      <a class="small" href={base + 'login/'}>Already trained on another device?</a>
    </div>
    <div class="notice notice-bad" id="t-error" hidden></div>
  </form>
</div>
<style is:global>
  .gated { display: none; }
  .gated.ready { display: block; }
</style>
<script>
  import { supabase } from '../lib/supabase.js';
  import { currentTrainee, startTraining } from '../lib/progress.js';

  const gate = document.getElementById('trainee-gate')!;
  const reveal = () => {
    gate.hidden = true;
    document.querySelectorAll('.gated').forEach((el) => el.classList.add('ready'));
    document.dispatchEvent(new CustomEvent('trainee-ready'));
  };

  (async () => {
    if (!supabase) return reveal(); // preview mode
    const t = await currentTrainee();
    if (t?.profile?.full_name) return reveal();
    if (t?.profile) {
      (document.getElementById('t-email') as HTMLInputElement).value = t.profile.email ?? t.user.email ?? '';
    }
    gate.hidden = false;
  })();

  document.getElementById('trainee-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = (e.target as HTMLFormElement).querySelector('button') as HTMLButtonElement;
    const err = document.getElementById('t-error')!;
    btn.disabled = true; err.hidden = true;
    try {
      await startTraining({
        full_name: (document.getElementById('t-name') as HTMLInputElement).value.trim(),
        email: (document.getElementById('t-email') as HTMLInputElement).value.trim(),
        nation: (document.getElementById('t-nation') as HTMLInputElement).value.trim(),
      });
      location.reload(); // refresh header + progress with the new identity
    } catch (ex: any) {
      err.hidden = false;
      err.textContent = 'Something went wrong: ' + (ex?.message ?? ex) + '. Please try again.';
      btn.disabled = false;
    }
  });
</script>
