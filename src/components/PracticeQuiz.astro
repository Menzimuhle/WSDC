---
interface Props { slug: string; quiz: any[] }
const { slug, quiz } = Astro.props;
const letters = 'ABCDEFGH';
const mcqCount = quiz.filter((q) => q.type === 'mcq').length;
---
{quiz.length > 0 && (
  <section class="card" id="practice" data-slug={slug} data-total={mcqCount}>
    <h2 style="margin-top:0">Practice quiz</h2>
    <p class="muted">Practice only, so nothing here counts towards placement. After each answer you'll see what we expected and why.</p>
    {quiz.map((q, i) => (
      <div class="quiz-q" data-type={q.type} data-answer={q.type === 'mcq' ? q.answer : undefined}>
        <h3>{i + 1}. {q.question}</h3>
        {q.type === 'mcq' ? (
          <>
            {q.options.map((o: string, j: number) => (
              <button type="button" class="opt" data-i={j}><span class="letter">{letters[j]}</span><span>{o}</span></button>
            ))}
            <div class="explain" hidden><strong></strong>{q.explanation}</div>
          </>
        ) : (
          <>
            <textarea aria-label="Your answer" placeholder="Write your answer, then compare it with the model answer."></textarea>
            <div class="row" style="margin-top:8px"><button type="button" class="btn btn-ghost btn-small reveal">Show model answer</button></div>
            <div class="explain" hidden><strong>Model answer</strong><span class="prompt">{q.model_answer}</span></div>
          </>
        )}
      </div>
    ))}
    <div class="notice" id="quiz-result" hidden></div>
    <div class="row">
      <button type="button" class="btn btn-ghost btn-small" id="quiz-reset">Try again</button>
    </div>
  </section>
)}

<script>
  import { loadProgress, saveProgress } from '../lib/progress.js';
  const root = document.getElementById('practice');
  if (root) {
    const slug = root.dataset.slug;
    const total = Number(root.dataset.total);
    let correct = 0, answered = 0;

    root.querySelectorAll('.quiz-q[data-type="mcq"]').forEach((qEl) => {
      const answer = Number((qEl as HTMLElement).dataset.answer);
      const opts = qEl.querySelectorAll<HTMLButtonElement>('.opt');
      opts.forEach((btn) => btn.addEventListener('click', () => {
        const pick = Number(btn.dataset.i);
        opts.forEach((b) => { b.disabled = true; });
        opts[answer].classList.add('correct');
        if (pick !== answer) btn.classList.add('wrong'); else correct++;
        const ex = qEl.querySelector('.explain') as HTMLElement;
        (ex.querySelector('strong') as HTMLElement).textContent = pick === answer ? 'Correct.' : 'Not quite.';
        ex.hidden = false;
        answered++;
        if (answered === total) finish();
      }));
    });

    root.querySelectorAll('.quiz-q[data-type="open"] .reveal').forEach((btn) => btn.addEventListener('click', () => {
      const ex = btn.closest('.quiz-q')!.querySelector('.explain') as HTMLElement;
      ex.hidden = !ex.hidden;
      btn.textContent = ex.hidden ? 'Show model answer' : 'Hide model answer';
    }));

    async function finish() {
      const out = document.getElementById('quiz-result')!;
      out.hidden = false;
      out.className = 'notice ' + (correct / total >= 0.8 ? 'notice-good' : 'notice-warn');
      out.textContent = `You got ${correct} of ${total} multiple-choice questions right.` +
        (correct / total >= 0.8 ? ' Nice work.' : ' Re-read the sections linked in the explanations and try again.');
      // Save the best score so far.
      const prev = (await loadProgress())[slug];
      if (!prev || (prev.practice_score ?? -1) < correct) await saveProgress(slug, { practice_score: correct, practice_total: total });
    }

    document.getElementById('quiz-reset')?.addEventListener('click', () => {
      correct = 0; answered = 0;
      root.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => { b.disabled = false; b.classList.remove('correct', 'wrong'); });
      root.querySelectorAll<HTMLElement>('.explain').forEach((e) => { e.hidden = true; });
      root.querySelectorAll<HTMLButtonElement>('.reveal').forEach((b) => { b.textContent = 'Show model answer'; });
      document.getElementById('quiz-result')!.hidden = true;
      root.scrollIntoView({ behavior: 'smooth' });
    });
  }
</script>
