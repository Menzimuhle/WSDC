---
import '../styles/global.css';
interface Props { title: string; description?: string; wide?: boolean }
const { title, description = 'Free training for World Schools Debating Championships judges.', wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const configured = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
const here = Astro.url.pathname;
const nav = [
  { href: base + 'modules/', label: 'Modules' },
  { href: base + 'final/', label: 'Final test' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'WSDC Judge Training' ? title : `${title} · WSDC Judge Training`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={base + 'favicon.png'} type="image/png" />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base}>
          <img src={base + 'lion.png'} alt="" width="54" height="40" />
          <span class="brand-text"><strong>WSDC Judge Training</strong><small>Sofia 2027</small></span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a href={base + 'admin/'} id="nav-admin" hidden aria-current={here.startsWith(base + 'admin/') ? 'page' : undefined}>Admin</a>
          <span class="nav-auth" id="nav-auth"></span>
        </nav>
      </div>
    </header>
    {!configured && (
      <div class="banner"><div class="container">Preview mode: Supabase isn't connected yet, so sign-in and saving are switched off. Modules and practice quizzes still work.</div></div>
    )}
    <main id="main" class:list={['container', { wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span class="footer-brand"><img src={base + 'lion.png'} alt="" width="38" height="28" /><strong style="color:#fff">Sofia WSDC 2027 · Judge Training</strong></span>
        <span>Built for judges preparing for the World Schools Debating Championships. Where this site and the WSDC Rules differ, the Rules prevail.</span>
        <a href={base + 'login/'} class="footer-link">Sign in with email (another device, or CA team)</a>
      </div>
    </footer>
    <script>
      import { supabase, path, esc } from '../lib/supabase.js';
      async function renderAuth() {
        const slot = document.getElementById('nav-auth');
        if (!supabase || !slot) return;
        const { data } = await supabase.auth.getSession();
        const user = data.session?.user;
        if (!user) return;
        const { data: prof } = await supabase.from('profiles').select('full_name, role, is_guest').eq('id', user.id).maybeSingle();
        if (prof?.role === 'admin') document.getElementById('nav-admin')?.removeAttribute('hidden');
        if (!prof?.full_name) return; // the details form on training pages takes care of this
        // Guests have no email link to get back in, so no sign-out button for them.
        slot.innerHTML = `<a href="${path('account/')}" class="nav-user" title="Your details">${esc(prof.full_name)}</a>` +
          (prof.is_guest ? '' : `<button class="btn btn-small btn-ghost" id="signout">Sign out</button>`);
        const so = document.getElementById('signout');
        if (so) so.onclick = async () => { await supabase.auth.signOut(); location.href = path(''); };
      }
      renderAuth();
    </script>
  </body>
</html>
